{
  "name": "pi-codex-pulse",
  "version": "1.2.0",
  "description": "Codex subscription usage, limits, credits, and confirmed reset redemption for Pi.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eValue8bv/pi-codex-pulse.git"
  },
  "homepage": "https://github.com/eValue8bv/pi-codex-pulse#readme",
  "bugs": "https://github.com/eValue8bv/pi-codex-pulse/issues",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
